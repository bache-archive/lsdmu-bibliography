{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CSL-ish Work (lenient pass)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "title",
    "issued"
  ],
  "definitions": {
    "name": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "literal"
          ]
        }
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "given": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "non-dropping-particle": {
          "type": "string"
        },
        "dropping-particle": {
          "type": "string"
        }
      }
    },
    "dateParts": {
      "type": "object",
      "properties": {
        "date-parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "date-parts"
      ]
    }
  },
  "properties": {
    "id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "article-journal",
        "article-magazine",
        "chapter",
        "report",
        "webpage",
        "interview"
      ]
    },
    "title": {
      "type": "string"
    },
    "issued": {
      "$ref": "#/definitions/dateParts"
    },
    "author": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "editor": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "container-title": {
      "type": "string"
    },
    "collection-title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "publisher-place": {
      "type": "string"
    },
    "volume": {
      "type": [
        "string",
        "integer"
      ]
    },
    "issue": {
      "type": [
        "string",
        "integer"
      ]
    },
    "page": {
      "type": "string"
    },
    "URL": {
      "type": "string"
    },
    "DOI": {
      "type": "string"
    },
    "ISBN": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}