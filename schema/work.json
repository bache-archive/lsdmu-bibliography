{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LSDMU Bibliography Entry (CSL-JSON + x-bache extension)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "type",
    "title",
    "issued",
    "x-bache"
  ],
  "definitions": {
    "name": {
      "type": "object",
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "literal"
          ]
        }
      ],
      "properties": {
        "family": {
          "type": "string"
        },
        "given": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        },
        "non-dropping-particle": {
          "type": "string"
        },
        "dropping-particle": {
          "type": "string"
        }
      }
    },
    "dateParts": {
      "type": "object",
      "properties": {
        "date-parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          }
        }
      },
      "required": [
        "date-parts"
      ]
    },
    "xbache": {
      "type": "object",
      "required": [
        "namespace",
        "citation_shorthand",
        "topics",
        "review_state",
        "provenance"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "enum": [
            "bache"
          ]
        },
        "citation_shorthand": {
          "type": "string"
        },
        "topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "review_state": {
          "type": "string",
          "enum": [
            "draft",
            "steward-reviewed",
            "ratified"
          ]
        },
        "mentioned_in": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provenance": {
          "type": "object",
          "properties": {
            "entered_by": {
              "type": "string"
            },
            "entered_at": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "entered_by",
            "entered_at"
          ]
        }
      },
      "additionalProperties": true
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^source:bache:LSDMU:bib:[a-z0-9\\-]+$"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "article-journal",
        "article-magazine",
        "chapter",
        "report",
        "webpage",
        "interview"
      ]
    },
    "title": {
      "type": "string"
    },
    "issued": {
      "$ref": "#/definitions/dateParts"
    },
    "original-date": {
      "$ref": "#/definitions/dateParts"
    },
    "author": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "editor": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "interviewer": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "translator": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/name"
      }
    },
    "container-title": {
      "type": "string"
    },
    "collection-title": {
      "type": "string"
    },
    "publisher": {
      "type": "string"
    },
    "publisher-place": {
      "type": "string"
    },
    "volume": {
      "type": [
        "string",
        "integer"
      ]
    },
    "issue": {
      "type": [
        "string",
        "integer"
      ]
    },
    "page": {
      "type": "string"
    },
    "DOI": {
      "type": "string"
    },
    "ISBN": {
      "type": "string"
    },
    "URL": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "x-bache": {
      "$ref": "#/definitions/xbache"
    },
    "note": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "$comment": "Deprecated — use x-bache.provenance.entered_by/entered_at instead."
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "Deprecated — use x-bache.topics instead."
    }
  }
}